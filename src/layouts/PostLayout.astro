---
import BaseLayout from './BaseLayout.astro';
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'blog'>;
  headings: { depth: number; slug: string; text: string }[];
  readingMinutes: number;
  prev?: { slug: string; title: string } | null;
  next?: { slug: string; title: string } | null;
}
const { entry, headings, readingMinutes, prev, next } = Astro.props;
const { title, description, pubDate, updatedDate, tags, category, heroImage } = entry.data;
const tocHeadings = headings.filter((h) => h.depth <= 3);
const shareUrl = new URL(Astro.url.pathname, Astro.site).toString();
const base = import.meta.env.BASE_URL;
---
<BaseLayout title={title} description={description} image={heroImage} article={true}>
  <article class="prose" style="padding-top:2.5rem;">
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <a href={base}>Home</a> / <a href={`${base}blog/`}>Blog</a> / <span>{title}</span>
    </nav>

    <h1>{title}</h1>
    <p style="color:var(--text-muted);font-size:0.9rem;">
      {pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
      {updatedDate && ` · Updated ${updatedDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}`}
      · {readingMinutes} min read · <a href={`${base}blog/category/${category.toLowerCase()}/`}>{category}</a>
    </p>

    <div class="tag-list">
      {tags.map((t: string) => <a class="tag" href={`${base}tags/${t.toLowerCase()}/`}>{t}</a>)}
    </div>

    {heroImage && <img src={heroImage} alt={title} style="margin: 1.5rem 0; width:100%; border-radius: var(--radius);" />}

    {tocHeadings.length > 2 && (
      <nav class="toc" aria-label="Table of contents">
        <strong>On this page</strong>
        <ul>
          {tocHeadings.map((h) => (
            <li style={`margin-left:${(h.depth - 2) * 0.75}rem`}><a href={`#${h.slug}`}>{h.text}</a></li>
          ))}
        </ul>
      </nav>
    )}

    <div class="post-body">
      <slot />
    </div>

    <div class="tag-list" style="margin-top:2rem;">
      <span style="color:var(--text-muted);font-size:0.85rem;">Share:</span>
      <a class="tag" href={`https://twitter.com/intent/tweet?url=${encodeURIComponent(shareUrl)}&text=${encodeURIComponent(title)}`} target="_blank" rel="noopener noreferrer">X / Twitter</a>
      <a class="tag" href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(shareUrl)}`} target="_blank" rel="noopener noreferrer">LinkedIn</a>
    </div>

    <nav class="section-heading no-print" style="margin-top: 2.5rem; border-top: 1px solid var(--border); padding-top: 1.5rem;">
      <div>{prev && <a href={`${base}blog/${prev.slug}/`}>&larr; {prev.title}</a>}</div>
      <div>{next && <a href={`${base}blog/${next.slug}/`}>{next.title} &rarr;</a>}</div>
    </nav>
  </article>
</BaseLayout>
