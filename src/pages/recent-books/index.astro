---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FeedList from '../../components/FeedList.astro';
import { getCollection } from 'astro:content';

const raw = (await getCollection('recentBooks')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const entries = await Promise.all(
  raw.map(async (e) => ({ slug: e.slug, data: e.data, Content: (await e.render()).Content }))
);
---
<BaseLayout title="Recent Books" description="Books, ranked, newest first.">
  <div class="prose" style="padding-top:2.5rem;">
    <h1>Recent Books</h1>
    <p style="color:var(--text-muted)">
      A running log of books with a star rating out of 5, newest first. To add one, create a new
      Markdown file in <code>src/content/recentBooks/</code> — use <code>title</code> for the book
      (e.g. "Book Title — Author") and <code>rating</code> (0–5).
    </p>
    <FeedList entries={entries} pdfDir="recent-books-files" emptyMessage="Nothing here yet — add a Markdown file to src/content/recentBooks/ to get started." />
  </div>
</BaseLayout>
