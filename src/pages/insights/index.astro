---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FeedList from '../../components/FeedList.astro';
import { getCollection } from 'astro:content';

const raw = (await getCollection('insights')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const entries = await Promise.all(
  raw.map(async (e) => ({ slug: e.slug, data: e.data, Content: (await e.render()).Content }))
);
---
<BaseLayout title="Insight of the Week" description="Short weekly notes and reflections.">
  <div class="prose" style="padding-top:2.5rem;">
    <h1>Insight of the Week</h1>
    <p style="color:var(--text-muted)">
      I enjoy formalizing my thoughts, because the process of thinking through something in detail can be 
    </p>
    <FeedList entries={entries} pdfDir="insights" emptyMessage="Nothing here yet — add a Markdown file to src/content/insights/ to get started." />
  </div>
</BaseLayout>
