---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Card from '../../components/Card.astro';
import { getCollection } from 'astro:content';

const papers = (await getCollection('research'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const categories = [...new Set(papers.map((p) => p.data.category))];
const base = import.meta.env.BASE_URL;
---
<BaseLayout title="Research" description="A library of research papers, notes, and writeups.">
  <div class="container">
    <h1>Research</h1>
    <p style="color:var(--text-muted)">
      To add a paper: drop the PDF into <code>public/papers/</code> and add one Markdown file to
      <code>src/content/research/</code>. This page, the download/preview buttons, search, and
      related-content links all update automatically.
    </p>

    <div class="tag-list" style="margin-bottom:1.5rem;">
      {categories.map((c) => <span class="tag">{c}</span>)}
    </div>

    <div class="card-grid">
      {papers.map((paper) => (
        <Card
          href={`${base}research/${paper.slug}/`}
          title={paper.data.title}
          description={paper.data.description}
          meta={`${paper.data.pubDate.toLocaleDateString()} · ${paper.data.category}`}
          tags={paper.data.keywords}
        />
      ))}
    </div>

    {papers.length === 0 && <p>No papers yet — add a Markdown file (with a matching PDF in <code>public/papers/</code>) to get started.</p>}
  </div>
</BaseLayout>
