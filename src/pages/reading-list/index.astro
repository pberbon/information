---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const books = await getCollection('books');
const statuses = ['Reading', 'Finished', 'Want to Read'];
---
<BaseLayout title="Reading List" description="Books I'm reading, have read, or want to read.">
  <div class="container">
    <h1>Reading List</h1>
    <input id="book-search" type="search" placeholder="Search books by title or author…"
      style="width:100%;max-width:420px;padding:0.6rem 0.9rem;border-radius:10px;border:1px solid var(--border);background:var(--bg-elevated);color:var(--text);margin-bottom:1.5rem;" />

    {statuses.map((status) => {
      const filtered = books.filter((b) => b.data.status === status);
      if (filtered.length === 0) return null;
      return (
        <section>
          <h2>{status}</h2>
          <div class="card-grid" id={`group-${status.replace(/\s+/g, '-').toLowerCase()}`}>
            {filtered.map((book) => (
              <a href={`#`} class="card book-card" data-title={book.data.title.toLowerCase()} data-author={book.data.author.toLowerCase()} style="text-decoration:none;">
                {book.data.cover && <img src={book.data.cover} alt={book.data.title} style="border-radius:8px;max-height:180px;object-fit:cover;" />}
                <h3>{book.data.title}</h3>
                <p>{book.data.author}</p>
                <div class="card-meta">{'★'.repeat(Math.round(book.data.rating))}{'☆'.repeat(5 - Math.round(book.data.rating))}</div>
                <div class="tag-list">
                  {book.data.categories.map((c: string) => <span class="tag">{c}</span>)}
                </div>
                {book.data.review && <p style="font-style:italic;">"{book.data.review}"</p>}
              </a>
            ))}
          </div>
        </section>
      );
    })}
    {books.length === 0 && <p>No books yet — add a Markdown file to <code>src/content/books/</code>.</p>}
  </div>

  <script>
    const input = document.getElementById('book-search') as HTMLInputElement | null;
    input?.addEventListener('input', () => {
      const q = input.value.trim().toLowerCase();
      document.querySelectorAll('.book-card').forEach((el) => {
        const title = (el as HTMLElement).dataset.title || '';
        const author = (el as HTMLElement).dataset.author || '';
        (el as HTMLElement).style.display = !q || title.includes(q) || author.includes(q) ? 'flex' : 'none';
      });
    });
  </script>
</BaseLayout>
