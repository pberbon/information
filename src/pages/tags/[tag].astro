---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Card from '../../components/Card.astro';

export async function getStaticPaths() {
  const [posts, papers, projects] = await Promise.all([
    getCollection('blog', ({ data }) => !data.draft),
    getCollection('research'),
    getCollection('projects'),
  ]);

  const allTags = new Set<string>();
  posts.forEach((p) => p.data.tags.forEach((t) => allTags.add(t.toLowerCase())));
  papers.forEach((p) => p.data.keywords.forEach((t) => allTags.add(t.toLowerCase())));
  projects.forEach((p) => p.data.tags.forEach((t) => allTags.add(t.toLowerCase())));

  return [...allTags].map((tag) => ({
    params: { tag },
    props: {
      tag,
      posts: posts.filter((p) => p.data.tags.some((t) => t.toLowerCase() === tag)),
      papers: papers.filter((p) => p.data.keywords.some((t) => t.toLowerCase() === tag)),
      projects: projects.filter((p) => p.data.tags.some((t) => t.toLowerCase() === tag)),
    },
  }));
}

const { tag, posts, papers, projects } = Astro.props;
---
<BaseLayout title={`Tag: ${tag}`}>
  <div class="container">
    <h1>Tag: #{tag}</h1>

    {posts.length > 0 && (
      <>
        <h2>Blog Posts</h2>
        <div class="card-grid">
          {posts.map((p: any) => <Card href={`/blog/${p.slug}/`} title={p.data.title} description={p.data.description} tags={p.data.tags} />)}
        </div>
      </>
    )}

    {papers.length > 0 && (
      <>
        <h2>Research Papers</h2>
        <div class="card-grid">
          {papers.map((p: any) => <Card href={`/research/${p.slug}/`} title={p.data.title} description={p.data.description} tags={p.data.keywords} />)}
        </div>
      </>
    )}

    {projects.length > 0 && (
      <>
        <h2>Projects</h2>
        <div class="card-grid">
          {projects.map((p: any) => <Card href={`/projects/${p.slug}/`} title={p.data.title} description={p.data.description} tags={p.data.tags} />)}
        </div>
      </>
    )}
  </div>
</BaseLayout>
