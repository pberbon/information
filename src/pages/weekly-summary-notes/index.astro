---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FeedList from '../../components/FeedList.astro';
import { getCollection } from 'astro:content';

const raw = (await getCollection('weeklySummary')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const entries = await Promise.all(
  raw.map(async (e) => ({ slug: e.slug, data: e.data, Content: (await e.render()).Content }))
);
---
<BaseLayout title="Weekly Rose Bud Thorn" description="A weekly update, newest first.">
  <div class="prose" style="padding-top:2.5rem;">
    <h1>Weekly Rose Bud Thorn</h1>
    <p style="color:var(--text-muted)">
      I think despite the bad press that this is one of the GOAT methods for summarizing a period of time. I am counting the weeks as Monday to Sunday with the date listed being the Sunday.

      Rose, Bud, Thorn is a simple reflection and feedback framework used to identify a positive highlight (Rose), an opportunity for growth or future potential (Bud), and a challenge or difficulty (Thorn). It is widely used in team project reviews, daily gratitude check-ins, and classroom settings
    </p>
    <FeedList entries={entries} pdfDir="weekly-summary-files" emptyMessage="Nothing here yet — add a Markdown file to src/content/weeklySummary/ to get started." />
  </div>
</BaseLayout>
