---
import BaseLayout from '../layouts/BaseLayout.astro';
const base = import.meta.env.BASE_URL;
---
<BaseLayout title="Resume" description="My resume, viewable and downloadable.">
  <div class="prose" style="padding-top:2.5rem;">
    <h1>Resume</h1>
    <p style="color:var(--text-muted)">
      To update: replace <code>public/resume/resume.pdf</code> with your latest file. No other changes needed.
    </p>
    <a class="button" href={`${base}resume/resume.pdf`} download style="margin-bottom:1.25rem;display:inline-block;">Download PDF</a>
    <object data={`${base}resume/resume.pdf`} type="application/pdf" class="pdf-embed">
      <p>Your browser can't preview PDFs inline. <a href={`${base}resume/resume.pdf`}>Download the resume</a> instead.</p>
    </object>
  </div>
</BaseLayout>
