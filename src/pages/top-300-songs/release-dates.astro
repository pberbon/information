---
import BaseLayout from '../../layouts/BaseLayout.astro';
import songs from '../../data/songs.json';

const base = import.meta.env.BASE_URL;

// Group songs by release year, one bucket per year — except everything
// before 2000, which is collapsed into a single "Pre-2000" bucket so the
// chart doesn't waste width on sparse early decades.
const cutoff = 2000;
const countsByBucket = new Map<string, number>();

for (const s of songs) {
  const year = new Date(s.releaseDate).getFullYear();
  const key = year < cutoff ? 'pre' : String(year);
  countsByBucket.set(key, (countsByBucket.get(key) || 0) + 1);
}

const hasPre = countsByBucket.has('pre');
const yearKeys = [...countsByBucket.keys()].filter((k) => k !== 'pre').map(Number);

let filledYears: number[] = [];
if (yearKeys.length > 0) {
  const minYear = Math.min(...yearKeys);
  const maxYear = Math.max(...yearKeys);
  for (let y = minYear; y <= maxYear; y++) filledYears.push(y);
}

const bucketKeys = [...(hasPre ? ['pre'] : []), ...filledYears.map(String)];

function bucketLabel(key: string) {
  return key === 'pre' ? 'Pre-2000' : key;
}

const maxCount = Math.max(1, ...countsByBucket.values());

const chartWidth = 800;
const chartHeight = 340;
const padding = { top: 30, right: 30, bottom: 50, left: 40 };
const plotWidth = chartWidth - padding.left - padding.right;
const plotHeight = chartHeight - padding.top - padding.bottom;

const points = bucketKeys.map((key, i) => {
  const count = countsByBucket.get(key) || 0;
  const x = bucketKeys.length > 1 ? padding.left + (i / (bucketKeys.length - 1)) * plotWidth : padding.left + plotWidth / 2;
  const y = chartHeight - padding.bottom - (count / maxCount) * plotHeight;
  return { key, count, x, y };
});

const linePath = points.map((p, i) => `${i === 0 ? 'M' : 'L'} ${p.x} ${p.y}`).join(' ');
const areaPath = points.length > 0
  ? `${linePath} L ${points[points.length - 1].x} ${chartHeight - padding.bottom} L ${points[0].x} ${chartHeight - padding.bottom} Z`
  : '';
---
<BaseLayout title="Top 300 Songs — Release Dates" description="Chart of release dates across the song list, one bucket per year (pre-2000 combined).">
  <div class="prose" style="padding-top:2.5rem; max-width: 900px;">
    <nav class="breadcrumbs"><a href={`${base}top-300-songs/`}>Top 300 Songs</a> / <span>Release Dates</span></nav>
    <h1>Release Dates</h1>
    <p style="color:var(--text-muted)">Number of songs released per year (everything before 2000 is combined into one bucket).</p>

    {points.length > 0 ? (
      <svg viewBox={`0 0 ${chartWidth} ${chartHeight}`} style="width: 100%; height: auto; font-family: var(--font-serif);">
        <line x1={padding.left} y1={chartHeight - padding.bottom} x2={chartWidth - padding.right} y2={chartHeight - padding.bottom} stroke="var(--border-strong)" stroke-width="1" />

        <path d={areaPath} fill="var(--accent)" opacity="0.25" stroke="none" />
        <path d={linePath} fill="none" stroke="var(--accent)" stroke-width="2.5" />

        {points.map((p) => (
          <g>
            <circle cx={p.x} cy={p.y} r="4" fill="var(--accent)" stroke="var(--bg)" stroke-width="1.5">
              <title>{`${bucketLabel(p.key)}: ${p.count} song${p.count === 1 ? '' : 's'}`}</title>
            </circle>
            <text x={p.x} y={p.y - 12} text-anchor="middle" font-size="12" fill="var(--text)">{p.count}</text>
            <text x={p.x} y={chartHeight - padding.bottom + 20} text-anchor="middle" font-size="11" fill="var(--text-muted)" transform={`rotate(-45, ${p.x}, ${chartHeight - padding.bottom + 20})`}>{bucketLabel(p.key)}</text>
          </g>
        ))}
      </svg>
    ) : (
      <p>No release dates to chart yet — add entries to <code>src/data/songs.json</code>.</p>
    )}
  </div>
</BaseLayout>