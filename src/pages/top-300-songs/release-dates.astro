---
import BaseLayout from '../../layouts/BaseLayout.astro';
import songs from '../../data/songs.json';

const base = import.meta.env.BASE_URL;

// Count songs per release year, then draw a simple bar chart as static SVG
// at build time — no chart library or client-side JS required.
const counts = new Map<number, number>();
for (const s of songs) {
  const year = new Date(s.releaseDate).getFullYear();
  counts.set(year, (counts.get(year) || 0) + 1);
}
const years = [...counts.keys()].sort((a, b) => a - b);
const maxCount = Math.max(1, ...counts.values());

const chartWidth = 800;
const chartHeight = 340;
const padding = { top: 20, right: 20, bottom: 50, left: 40 };
const plotWidth = chartWidth - padding.left - padding.right;
const plotHeight = chartHeight - padding.top - padding.bottom;
const barGap = 10;
const barWidth = years.length > 0 ? (plotWidth - barGap * (years.length - 1)) / years.length : 0;
---
<BaseLayout title="Top 300 Songs — Release Dates" description="Chart of release dates across the song list.">
  <div class="prose" style="padding-top:2.5rem; max-width: 900px;">
    <nav class="breadcrumbs"><a href={`${base}top-300-songs/`}>Top 300 Songs</a> / <span>Release Dates</span></nav>
    <h1>Release Dates</h1>
    <p style="color:var(--text-muted)">Number of songs on the list released in each year.</p>

    {years.length > 0 ? (
      <svg viewBox={`0 0 ${chartWidth} ${chartHeight}`} style="width: 100%; height: auto; font-family: var(--font-serif);">
        {/* baseline */}
        <line x1={padding.left} y1={chartHeight - padding.bottom} x2={chartWidth - padding.right} y2={chartHeight - padding.bottom} stroke="var(--border-strong)" stroke-width="1" />

        {years.map((year, i) => {
          const count = counts.get(year) || 0;
          const barHeight = (count / maxCount) * plotHeight;
          const x = padding.left + i * (barWidth + barGap);
          const y = chartHeight - padding.bottom - barHeight;
          return (
            <g>
              <rect x={x} y={y} width={barWidth} height={barHeight} fill="var(--accent)" stroke="var(--border-strong)" stroke-width="1" />
              <text x={x + barWidth / 2} y={y - 6} text-anchor="middle" font-size="13" fill="var(--text)">{count}</text>
              <text x={x + barWidth / 2} y={chartHeight - padding.bottom + 18} text-anchor="middle" font-size="13" fill="var(--text-muted)">{year}</text>
            </g>
          );
        })}
      </svg>
    ) : (
      <p>No release dates to chart yet — add entries to <code>src/data/songs.json</code>.</p>
    )}
  </div>
</BaseLayout>
