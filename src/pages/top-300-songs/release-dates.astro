---
import BaseLayout from '../../layouts/BaseLayout.astro';
import songs from '../../data/songs.json';

const base = import.meta.env.BASE_URL;

// Group songs by their exact release date, then plot count-per-date as a
// filled line chart across a continuous time axis (not evenly-spaced
// categories) — so gaps and clusters in time show up honestly.
const countsByDate = new Map<string, number>();
for (const s of songs) {
  countsByDate.set(s.releaseDate, (countsByDate.get(s.releaseDate) || 0) + 1);
}
const sortedDates = [...countsByDate.keys()].sort(
  (a, b) => new Date(a).getTime() - new Date(b).getTime()
);
const maxCount = Math.max(1, ...countsByDate.values());

const chartWidth = 800;
const chartHeight = 340;
const padding = { top: 30, right: 30, bottom: 50, left: 40 };
const plotWidth = chartWidth - padding.left - padding.right;
const plotHeight = chartHeight - padding.top - padding.bottom;

const timestamps = sortedDates.map((d) => new Date(d).getTime());
const minTime = Math.min(...timestamps);
const maxTime = Math.max(...timestamps);
const timeSpan = maxTime - minTime || 1;

const points = sortedDates.map((dateStr) => {
  const t = new Date(dateStr).getTime();
  const count = countsByDate.get(dateStr) || 0;
  const x = padding.left + ((t - minTime) / timeSpan) * plotWidth;
  const y = chartHeight - padding.bottom - (count / maxCount) * plotHeight;
  return { dateStr, count, x, y, t };
});

const linePath = points.map((p, i) => `${i === 0 ? 'M' : 'L'} ${p.x} ${p.y}`).join(' ');
const areaPath = points.length > 0
  ? `${linePath} L ${points[points.length - 1].x} ${chartHeight - padding.bottom} L ${points[0].x} ${chartHeight - padding.bottom} Z`
  : '';

const labelCount = Math.min(8, sortedDates.length);
const axisLabels = Array.from({ length: labelCount }, (_, i) => {
  const t = minTime + (i / Math.max(1, labelCount - 1)) * timeSpan;
  const x = padding.left + ((t - minTime) / timeSpan) * plotWidth;
  const year = new Date(t).getFullYear();
  return { x, year };
});
---
<BaseLayout title="Top 300 Songs — Release Dates" description="Chart of release dates across the song list.">
  <div class="prose" style="padding-top:2.5rem; max-width: 900px;">
    <nav class="breadcrumbs"><a href={`${base}top-300-songs/`}>Top 300 Songs</a> / <span>Release Dates</span></nav>
    <h1>Release Dates</h1>
    <p style="color:var(--text-muted)">Number of songs released on each date, plotted over time.</p>

    {points.length > 0 ? (
      <svg viewBox={`0 0 ${chartWidth} ${chartHeight}`} style="width: 100%; height: auto; font-family: var(--font-serif);">
        <line x1={padding.left} y1={chartHeight - padding.bottom} x2={chartWidth - padding.right} y2={chartHeight - padding.bottom} stroke="var(--border-strong)" stroke-width="1" />

        {axisLabels.map((label) => (
          <text x={label.x} y={chartHeight - padding.bottom + 20} text-anchor="middle" font-size="12" fill="var(--text-muted)">{label.year}</text>
        ))}

        <path d={areaPath} fill="var(--accent)" opacity="0.25" stroke="none" />
        <path d={linePath} fill="none" stroke="var(--accent)" stroke-width="2.5" />

        {points.map((p) => (
          <g>
            <circle cx={p.x} cy={p.y} r="4" fill="var(--accent)" stroke="var(--bg)" stroke-width="1.5">
              <title>{`${p.dateStr}: ${p.count} song${p.count === 1 ? '' : 's'}`}</title>
            </circle>
            {p.count > 1 && (
              <text x={p.x} y={p.y - 12} text-anchor="middle" font-size="12" fill="var(--text)">{p.count}</text>
            )}
          </g>
        ))}
      </svg>
    ) : (
      <p>No release dates to chart yet — add entries to <code>src/data/songs.json</code>.</p>
    )}
  </div>
</BaseLayout>