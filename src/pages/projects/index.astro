---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FeedList from '../../components/FeedList.astro';
import { getCollection } from 'astro:content';

const raw = (await getCollection('projects')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const entries = await Promise.all(
  raw.map(async (e) => ({ slug: e.slug, data: e.data, Content: (await e.render()).Content }))
);
---
<BaseLayout title="Projects" description="Things I've built, with updates as they evolve.">
  <div class="prose" style="padding-top:2.5rem;">
    <h1>Projects</h1>
    <p style="color:var(--text-muted)">
      A running log, newest first. To add an entry, create a new Markdown file in
      <code>src/content/projects/</code>.
    </p>
    <FeedList entries={entries} pdfDir="project-files" emptyMessage="Nothing here yet — add a Markdown file to src/content/projects/ to get started." />
  </div>
</BaseLayout>
