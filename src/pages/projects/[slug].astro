---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Card from '../../components/Card.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({ params: { slug: project.slug }, props: { project, all: projects } }));
}

const { project, all } = Astro.props;
const { title, description, technologies, image, github, externalLink, status, date, tags } = project.data;
const { Content } = await project.render();

const related = all
  .filter((p) => p.slug !== project.slug)
  .map((p) => ({ p, overlap: p.data.tags.filter((t) => tags.includes(t)).length }))
  .filter((x) => x.overlap > 0)
  .sort((a, b) => b.overlap - a.overlap)
  .slice(0, 3)
  .map((x) => x.p);
---
<BaseLayout title={title} description={description} image={image}>
  <div class="prose" style="padding-top:2.5rem;">
    <nav class="breadcrumbs"><a href="/">Home</a> / <a href="/projects/">Projects</a> / <span>{title}</span></nav>
    <h1>{title}</h1>
    <p style="color:var(--text-muted)">{status} · {date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</p>

    <div class="tag-list">
      {tags.map((t: string) => <a class="tag" href={`/tags/${t.toLowerCase()}/`}>{t}</a>)}
    </div>

    {image && <img src={image} alt={title} style="margin:1.5rem 0;width:100%;border-radius:var(--radius)" />}

    <p><strong>Technologies:</strong> {technologies.join(', ')}</p>

    <div class="tag-list" style="margin:1rem 0;">
      {github && <a class="button secondary" href={github} target="_blank" rel="noopener noreferrer">GitHub</a>}
      {externalLink && <a class="button" href={externalLink} target="_blank" rel="noopener noreferrer">Visit Project</a>}
    </div>

    <Content />

    {related.length > 0 && (
      <>
        <h2>Related Projects</h2>
        <div class="card-grid">
          {related.map((r) => (
            <Card href={`/projects/${r.slug}/`} title={r.data.title} description={r.data.description} tags={r.data.tags} />
          ))}
        </div>
      </>
    )}
  </div>
</BaseLayout>
