---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Card from '../../components/Card.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const categories = [...new Set(posts.map((p) => p.data.category))];
---
<BaseLayout title="Blog" description="Writing on research, engineering, and side projects.">
  <div class="container">
    <h1>Blog</h1>
    <p style="color:var(--text-muted)">All posts, newest first. Filter by category below, or use the search icon in the nav.</p>

    <div class="tag-list" style="margin-bottom:1.5rem;">
      {categories.map((c) => <a class="tag" href={`/blog/category/${c.toLowerCase()}/`}>{c}</a>)}
    </div>

    <div class="card-grid">
      {posts.map((post) => (
        <Card
          href={`/blog/${post.slug}/`}
          title={post.data.title}
          description={post.data.description}
          meta={`${post.data.pubDate.toLocaleDateString()} · ${post.data.category}`}
          tags={post.data.tags}
        />
      ))}
    </div>

    {posts.length === 0 && <p>No posts yet — add a Markdown file to <code>src/content/blog/</code> to get started.</p>}
  </div>
</BaseLayout>
