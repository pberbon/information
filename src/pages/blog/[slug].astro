---
import { getCollection } from 'astro:content';
import PostLayout from '../../layouts/PostLayout.astro';
import readingTime from 'reading-time';

export async function getStaticPaths() {
  const posts = (await getCollection('blog', ({ data }) => !data.draft))
    .sort((a, b) => a.data.pubDate.valueOf() - b.data.pubDate.valueOf());

  return posts.map((post, index) => ({
    params: { slug: post.slug },
    props: {
      entry: post,
      prev: index > 0 ? { slug: posts[index - 1].slug, title: posts[index - 1].data.title } : null,
      next: index < posts.length - 1 ? { slug: posts[index + 1].slug, title: posts[index + 1].data.title } : null,
    },
  }));
}

const { entry, prev, next } = Astro.props;
const { Content, headings } = await entry.render();
const stats = readingTime(entry.body);
const readingMinutes = Math.max(1, Math.round(stats.minutes));
---
<PostLayout entry={entry} headings={headings} readingMinutes={readingMinutes} prev={prev} next={next}>
  <Content />
</PostLayout>
