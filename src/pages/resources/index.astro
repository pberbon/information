---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FeedList from '../../components/FeedList.astro';
import { getCollection } from 'astro:content';

const raw = (await getCollection('resources')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const entries = await Promise.all(
  raw.map(async (e) => ({ slug: e.slug, data: e.data, Content: (await e.render()).Content }))
);
---
<BaseLayout title="Resources" description="Useful papers, tools, courses, and sites, newest first.">
  <div class="prose" style="padding-top:2.5rem;">
    <h1>Resources</h1>
    <p style="color:var(--text-muted)">
      A running log, newest first. To add an entry, create a new Markdown file in
      <code>src/content/resources/</code>.
    </p>
    <FeedList entries={entries} pdfDir="resource-files" emptyMessage="Nothing here yet — add a Markdown file to src/content/resources/ to get started." />
  </div>
</BaseLayout>
