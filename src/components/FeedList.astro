---
import RoseBudThorn from './RoseBudThorn.astro';

// Shared by every "feed" tab. Each entry is a dated chunk of text with an
// optional title, an optional star rating, and an optional attached PDF —
// no separate page per entry. `slug` is used as an anchor id so entries
// stay linkable (e.g. from the homepage) even without their own route.
interface Entry {
  slug: string;
  data: { date: Date; title?: string; rating?: number; pdfFile?: string; rose?: string; bud?: string; thorn?: string };
  Content: any;
}
interface Props {
  entries: Entry[];
  pdfDir: string; // folder under /public/ where this tab's PDFs live, e.g. "papers"
  emptyMessage: string;
  responseFormEndpoint?: string; // if set, each entry gets its own "submit a response" box
  titleFontSize?: string; // override the entry title size, e.g. "1.3rem"
}
const { entries, pdfDir, emptyMessage, responseFormEndpoint, titleFontSize } = Astro.props;
const base = import.meta.env.BASE_URL;
---
{entries.map(({ slug, data, Content }) => (
  <article id={slug} style="margin: 2.5rem 0; padding-top: 1.75rem; border-top: 1px solid var(--border); scroll-margin-top: 5rem;">
    <p style="color:var(--text-muted); font-style: italic; margin-bottom: 0.5rem;">
      {data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
    </p>
    {data.title && <h2 style={`margin-top:0; margin-bottom: 0.25rem;${titleFontSize ? ` font-size:${titleFontSize};` : ''}`}>{data.title}</h2>}
    {typeof data.rating === 'number' && (() => {
      const fillPercent = Math.max(0, Math.min(100, (data.rating / 5) * 100));
      return (
        <div style="display: flex; align-items: center; gap: 0.5rem; margin: 0 0 0.75rem;">
          <div
            style="position: relative; display: inline-block; line-height: 1; font-size: 1.1rem;"
            aria-label={`Rated ${data.rating} out of 5`}
          >
            <div style="color: var(--border-strong); white-space: nowrap;">☆☆☆☆☆</div>
            <div style={`position:absolute; top:0; left:0; overflow:hidden; white-space:nowrap; width:${fillPercent}%; color: var(--brass);`}>★★★★★</div>
          </div>
          <span style="color: var(--text-muted); font-size: 0.9rem;">{data.rating} / 5</span>
        </div>
      );
    })()}
    {data.rose && data.bud && data.thorn && (
      <RoseBudThorn rose={data.rose} bud={data.bud} thorn={data.thorn} />
    )}
    <div class="post-body">
      <Content />
    </div>
    {data.pdfFile && (
      <a class="button secondary" href={`${base}${pdfDir}/${data.pdfFile}`} download style="margin-top: 0.75rem; display: inline-block;">
        Download PDF
      </a>
    )}

    {responseFormEndpoint && (
      <div class="response-box">
        <form class="response-form" data-endpoint={responseFormEndpoint} data-question={data.title || slug}>
          <input type="text" name="respondent" placeholder="Your name (optional)" autocomplete="off"
            style="padding:0.6rem 0.9rem;border-radius:var(--radius);border:1px solid var(--border);background:var(--bg);color:var(--text);font-family:var(--font-serif);" />
          <textarea name="answer" placeholder="Your response" rows="3" required autocomplete="off"
            style="padding:0.6rem 0.9rem;border-radius:var(--radius);border:1px solid var(--border);background:var(--bg);color:var(--text);font-family:var(--font-serif);"></textarea>
          <input type="hidden" name="question" value={data.title || slug} />
          <button type="submit" class="button" style="align-self:flex-start;">Submit Response</button>
          <p class="response-status" style="margin: 0; font-size: 0.9rem;"></p>
        </form>
      </div>
    )}
  </article>
))}
{entries.length === 0 && <p>{emptyMessage}</p>}

{responseFormEndpoint && (
  <style>
    .response-box {
      border: 1px solid var(--border-strong);
      border-radius: var(--radius);
      background: var(--bg-elevated);
      padding: 1.1rem 1.4rem;
      margin-top: 1.25rem;
    }
    .response-form {
      display: flex;
      flex-direction: column;
      gap: 0.6rem;
      max-width: 480px;
    }
  </style>
)}

{responseFormEndpoint && (
  <script>
    document.querySelectorAll('.response-form').forEach((form) => {
      const status = form.querySelector('.response-status');
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        const endpoint = (form as HTMLFormElement).dataset.endpoint;
        if (!status) return;

        if (!endpoint || endpoint.includes('YOUR_FORM_ID')) {
          status.textContent = "This form isn't connected yet.";
          (status as HTMLElement).style.color = 'var(--accent)';
          return;
        }

        status.textContent = 'Sending…';
        (status as HTMLElement).style.color = 'var(--text-muted)';

        try {
          const response = await fetch(endpoint, {
            method: 'POST',
            headers: { Accept: 'application/json' },
            body: new FormData(form as HTMLFormElement),
          });
          if (response.ok) {
            status.textContent = 'Thanks — your response was sent!';
            (status as HTMLElement).style.color = 'var(--brass)';
            (form as HTMLFormElement).reset();
          } else {
            status.textContent = 'Something went wrong — please try again.';
            (status as HTMLElement).style.color = 'var(--accent)';
          }
        } catch {
          status.textContent = 'Something went wrong — please try again.';
          (status as HTMLElement).style.color = 'var(--accent)';
        }
      });
    });
  </script>
)}