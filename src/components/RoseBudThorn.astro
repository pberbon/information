---
// Usage inside any page or entry:
//   <RoseBudThorn rose="What went well" bud="What I'm looking forward to" thorn="What was hard" />
interface Props {
  rose: string;
  bud: string;
  thorn: string;
}
const { rose, bud, thorn } = Astro.props;
---
<div class="rbt-list">
  <div class="rbt-item">
    <span class="rbt-icon-wrap">
      <svg class="rbt-icon" viewBox="0 0 24 24" width="16" height="16">
        <circle cx="12" cy="8.6" r="3.1" fill="var(--accent)" />
        <circle cx="8.77" cy="10.95" r="3.1" fill="var(--accent)" />
        <circle cx="10.0" cy="14.75" r="3.1" fill="var(--accent)" />
        <circle cx="14.0" cy="14.75" r="3.1" fill="var(--accent)" />
        <circle cx="15.23" cy="10.95" r="3.1" fill="var(--accent)" />
      </svg>
    </span>
    <span><strong>Rose:</strong> {rose}</span>
  </div>

  <div class="rbt-item">
    <span class="rbt-icon-wrap">
      <svg class="rbt-icon" viewBox="0 0 24 24" width="16" height="16">
        <circle cx="12" cy="12" r="6" fill="var(--brass)" />
      </svg>
    </span>
    <span><strong>Bud:</strong> {bud}</span>
  </div>

  <div class="rbt-item">
    <span class="rbt-icon-wrap">
      <svg class="rbt-icon" viewBox="0 0 24 24" width="16" height="16">
        <path d="M12 3 C16 5 15 12 11 21 C9 15 8 7 12 3 Z" fill="var(--text-muted)" />
      </svg>
    </span>
    <span><strong>Thorn:</strong> {thorn}</span>
  </div>
</div>

<style>
  .rbt-list {
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
    margin: 0.75rem 0 1.25rem;
  }
  .rbt-item {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
  }
  .rbt-icon-wrap {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 20px;
    height: 1.7em;
  }
</style>