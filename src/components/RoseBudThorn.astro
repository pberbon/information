---
// Usage inside any page or entry:
//   <RoseBudThorn rose="What went well" bud="What I'm looking forward to" thorn="What was hard" />
interface Props {
  rose: string;
  bud: string;
  thorn: string;
}
const { rose, bud, thorn } = Astro.props;
---
<div class="rbt-list">
  <div class="rbt-item">
    <svg class="rbt-icon" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="var(--accent)" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round">
      <circle cx="12" cy="4.2" r="2.1" />
      <circle cx="9.81" cy="5.79" r="2.1" />
      <circle cx="10.65" cy="8.36" r="2.1" />
      <circle cx="13.35" cy="8.36" r="2.1" />
      <circle cx="14.19" cy="5.79" r="2.1" />
      <circle cx="12" cy="6.5" r="1" fill="var(--accent)" stroke="none" />
      <path d="M12 9.5V21" />
      <path d="M12 14c-1.4-.3-2.5.2-3.2 1.1M12 17.3c1.4-.3 2.5.2 3.2 1.1" />
    </svg>
    <span><strong>Rose:</strong> {rose}</span>
  </div>

  <div class="rbt-item">
    <svg class="rbt-icon" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="var(--brass)" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
      <path d="M12 5c-1.8 0-3.2 1.4-3.2 3.1 0 2 1.6 3.4 3.2 4.2 1.6-.8 3.2-2.2 3.2-4.2C15.2 6.4 13.8 5 12 5z" />
      <path d="M12 12.3V21" />
      <path d="M12 15.5c-1.2-.2-2.2.3-2.8 1.1M12 17.5c1.2-.2 2.2.3 2.8 1.1" />
    </svg>
    <span><strong>Bud:</strong> {bud}</span>
  </div>

  <div class="rbt-item">
    <svg class="rbt-icon" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="var(--text-muted)" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
      <path d="M12 4v17" />
      <path d="M12 8c2-1.5 4-1.2 5.5.3C16 9.8 13.8 10 12 8.5" />
      <path d="M12 13c-2-1.5-4-1.2-5.5.3C8 15.3 10.2 15 12 13.5" />
    </svg>
    <span><strong>Thorn:</strong> {thorn}</span>
  </div>
</div>

<style>
  .rbt-list {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    margin: 0.75rem 0 1.25rem;
  }
  .rbt-item {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
  }
  .rbt-icon {
    flex-shrink: 0;
    margin-top: 0.15rem;
  }
</style>