---
import { SITE, NAV_LINKS } from '../site.config';
const currentPath = Astro.url.pathname;
---
<header class="site-nav">
  <div class="nav-inner">
    <a href="/" class="brand">{SITE.name}</a>
    <nav aria-label="Primary">
      <ul class="nav-links">
        {NAV_LINKS.map((link) => (
          <li>
            <a href={link.href} aria-current={currentPath === link.href ? 'page' : undefined}>
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
    <div class="nav-right">
      <button id="search-open" class="icon-btn" aria-label="Search site" title="Search (/)">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/></svg>
      </button>
      <button id="theme-toggle" class="icon-btn" aria-label="Toggle dark mode">
        <svg id="theme-icon-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
        <svg id="theme-icon-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="display:none"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
      </button>
    </div>
  </div>
</header>

<div id="search-overlay" class="search-overlay" hidden>
  <div class="search-panel">
    <input id="search-input" type="search" placeholder="Search blog posts, papers, projects…" aria-label="Search" />
    <div id="search-results"></div>
  </div>
</div>

<style>
  .search-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,0.5);
    z-index: 100;
    display: flex;
    align-items: flex-start;
    justify-content: center;
    padding-top: 10vh;
  }
  .search-panel {
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    width: min(560px, 90vw);
    padding: 1rem;
    box-shadow: var(--shadow);
  }
  #search-input {
    width: 100%;
    padding: 0.6rem 0.8rem;
    border-radius: 10px;
    border: 1px solid var(--border);
    background: var(--bg-elevated);
    color: var(--text);
    font-size: 1rem;
  }
  #search-results { margin-top: 0.75rem; max-height: 50vh; overflow-y: auto; }
  #search-results a {
    display: block;
    padding: 0.5rem 0.4rem;
    border-radius: 8px;
    color: var(--text);
  }
  #search-results a:hover { background: var(--bg-elevated); text-decoration: none; }
</style>

<script>
  // Theme toggle: persists via a class on <html>, no localStorage-dependent
  // rendering flash because inline script in BaseLayout sets it pre-paint.
  const toggle = document.getElementById('theme-toggle');
  const sun = document.getElementById('theme-icon-sun');
  const moon = document.getElementById('theme-icon-moon');

  function syncIcons() {
    const isDark = document.documentElement.getAttribute('data-theme') === 'dark';
    if (sun) (sun as HTMLElement).style.display = isDark ? 'none' : 'block';
    if (moon) (moon as HTMLElement).style.display = isDark ? 'block' : 'none';
  }
  syncIcons();

  toggle?.addEventListener('click', () => {
    const html = document.documentElement;
    const next = html.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
    html.setAttribute('data-theme', next);
    try { localStorage.setItem('theme', next); } catch {}
    syncIcons();
  });

  // Simple search overlay wiring; actual search logic lives in pagefind
  // (loaded lazily) once the user starts typing.
  const openBtn = document.getElementById('search-open');
  const overlay = document.getElementById('search-overlay');
  const input = document.getElementById('search-input') as HTMLInputElement | null;
  const results = document.getElementById('search-results');

  function openSearch() {
    overlay?.removeAttribute('hidden');
    input?.focus();
  }
  function closeSearch() {
    overlay?.setAttribute('hidden', '');
    if (input) input.value = '';
    if (results) results.innerHTML = '';
  }
  openBtn?.addEventListener('click', openSearch);
  overlay?.addEventListener('click', (e) => { if (e.target === overlay) closeSearch(); });
  document.addEventListener('keydown', (e) => {
    if (e.key === '/' && document.activeElement?.tagName !== 'INPUT') {
      e.preventDefault();
      openSearch();
    }
    if (e.key === 'Escape') closeSearch();
  });

  let pagefindLoaded = false;
  let pf: any = null;
  input?.addEventListener('input', async () => {
    const q = input.value.trim();
    if (!q) { if (results) results.innerHTML = ''; return; }
    try {
      if (!pagefindLoaded) {
        // @ts-ignore — generated at build time by the pagefind CLI step
        pf = await import(/* @vite-ignore */ `${import.meta.env.BASE_URL}pagefind/pagefind.js`);
        await pf.init();
        pagefindLoaded = true;
      }
      const search = await pf.search(q);
      const items = await Promise.all(search.results.slice(0, 8).map((r: any) => r.data()));
      if (results) {
        results.innerHTML = items
          .map((item: any) => `<a href="${item.url}"><strong>${item.meta.title || item.url}</strong><br/><span style="color:var(--text-muted);font-size:0.85rem">${item.excerpt}</span></a>`)
          .join('') || '<p style="color:var(--text-muted);padding:0.5rem">No results yet — run a production build for search to work.</p>';
      }
    } catch (err) {
      if (results) results.innerHTML = '<p style="color:var(--text-muted);padding:0.5rem">Search index not found. Search works after running <code>npm run build</code> (it is generated by Pagefind).</p>';
    }
  });
</script>
