---
import { SITE, NAV_LINKS } from '../site.config';
const currentPath = Astro.url.pathname;
const base = import.meta.env.BASE_URL;
---
<header class="site-nav">
  <div class="nav-inner">
    <nav aria-label="Primary">
      <ul class="nav-links">
        {NAV_LINKS.map((link) => {
          const href = base + link.href.replace(/^\//, '');
          return (
            <li>
              <a href={href} aria-current={currentPath === href ? 'page' : undefined}>
                {link.label}
              </a>
            </li>
          );
        })}
      </ul>
    </nav>
    <div class="nav-right">
      <button id="theme-toggle" class="icon-btn" aria-label="Toggle dark mode">
        <svg id="theme-icon-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
        <svg id="theme-icon-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="display:none"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
      </button>
      <button id="mobile-menu-toggle" class="icon-btn" aria-label="Open menu" aria-expanded="false">
        <svg id="menu-icon-open" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18M3 12h18M3 18h18"/></svg>
        <svg id="menu-icon-close" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="display:none"><path d="M18 6 6 18M6 6l12 12"/></svg>
      </button>
    </div>
  </div>

  <nav id="mobile-menu" aria-label="Primary mobile" class="mobile-menu">
    <ul>
      {NAV_LINKS.map((link) => {
        const href = base + link.href.replace(/^\//, '');
        return (
          <li>
            <a href={href} aria-current={currentPath === href ? 'page' : undefined}>
              {link.label}
            </a>
          </li>
        );
      })}
    </ul>
  </nav>
</header>

<style>
  #mobile-menu-toggle {
    display: none;
  }
  .mobile-menu {
    display: none;
  }

  @media (max-width: 640px) {
    #mobile-menu-toggle {
      display: flex;
    }
    .mobile-menu.open {
      display: block;
      border-top: 1px solid var(--border-strong);
      background: var(--bg);
    }
    .mobile-menu ul {
      list-style: none;
      margin: 0;
      padding: 0.5rem 1.5rem 1rem;
      display: flex;
      flex-direction: column;
    }
    .mobile-menu a {
      display: block;
      padding: 0.75rem 0;
      color: var(--text-muted);
      font-size: 0.95rem;
      font-weight: 600;
      letter-spacing: 0.04em;
      text-transform: uppercase;
      border-bottom: 1px solid var(--border);
    }
    .mobile-menu li:last-child a {
      border-bottom: none;
    }
    .mobile-menu a[aria-current="page"] {
      color: var(--accent);
    }
  }
</style>

<script>
  const toggle = document.getElementById('theme-toggle');
  const sun = document.getElementById('theme-icon-sun');
  const moon = document.getElementById('theme-icon-moon');

  function syncIcons() {
    const isDark = document.documentElement.getAttribute('data-theme') === 'dark';
    if (sun) (sun as HTMLElement).style.display = isDark ? 'none' : 'block';
    if (moon) (moon as HTMLElement).style.display = isDark ? 'block' : 'none';
  }
  syncIcons();

  toggle?.addEventListener('click', () => {
    const html = document.documentElement;
    const next = html.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
    html.setAttribute('data-theme', next);
    try { localStorage.setItem('theme', next); } catch {}
    syncIcons();
  });

  const menuToggle = document.getElementById('mobile-menu-toggle');
  const menuOpenIcon = document.getElementById('menu-icon-open');
  const menuCloseIcon = document.getElementById('menu-icon-close');
  const mobileMenu = document.getElementById('mobile-menu');

  menuToggle?.addEventListener('click', () => {
    const isOpen = mobileMenu?.classList.toggle('open');
    menuToggle.setAttribute('aria-expanded', String(!!isOpen));
    menuToggle.setAttribute('aria-label', isOpen ? 'Close menu' : 'Open menu');
    if (menuOpenIcon) (menuOpenIcon as HTMLElement).style.display = isOpen ? 'none' : 'block';
    if (menuCloseIcon) (menuCloseIcon as HTMLElement).style.display = isOpen ? 'block' : 'none';
  });
</script>