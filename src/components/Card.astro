---
interface Props {
  href: string;
  title: string;
  description?: string;
  meta?: string;
  tags?: string[];
}
const { href, title, description, meta, tags = [] } = Astro.props;
---
<a href={href} class="card" style="text-decoration:none;">
  <h3>{title}</h3>
  {description && <p>{description}</p>}
  {meta && <div class="card-meta">{meta}</div>}
  {tags.length > 0 && (
    <div class="tag-list">
      {tags.slice(0, 4).map((t) => <span class="tag">{t}</span>)}
    </div>
  )}
</a>
