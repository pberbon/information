---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FeedList from '../../components/FeedList.astro';
import { getCollection } from 'astro:content';

const raw = (await getCollection('research')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const entries = await Promise.all(
  raw.map(async (e) => ({ slug: e.slug, data: e.data, Content: (await e.render()).Content }))
);
---
<BaseLayout title="Research" description="A running library of research notes and papers.">
  <div class="prose" style="padding-top:2.5rem;">
    <h1>Research</h1>
    <p style="color:var(--text-muted)">
      A running log, newest first. To add an entry, create a new Markdown file in
      <code>src/content/research/</code>. To attach a PDF, drop it in <code>public/papers/</code>
      and set <code>pdfFile</code> to its filename.
    </p>
    <FeedList entries={entries} pdfDir="papers" emptyMessage="Nothing here yet — add a Markdown file to src/content/research/ to get started." />
  </div>
</BaseLayout>
